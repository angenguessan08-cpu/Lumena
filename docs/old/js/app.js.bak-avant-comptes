    return `<tr><td>${esc(c.nom)}</td><td>${badge(c.groupe)}</td><td class="num">${fmt(t)}</td><td class="num"><b>${fmt(r)}</b></td><td class="num ${bad?'bad':'mute'}">${t?(r-t>0?'+':'−')+' '+fmt(Math.abs(r-t)):'—'}</td><td><div class="bar"><i style="width:${Math.min(100,p)}%;${bad?'background:var(--bad)':''}"></i></div><small class="mute">${t?pct(p):'sans cible'}</small></td></tr>`}).join('')}</tbody></table></div>`;
  ctlBind(el);
  $('#xb').onclick=()=>{download(xlsx([{name:'Budget',rows:[['Catégorie','Groupe','Type','Cible','Réel','Écart'],...rows.map(({c,t,r})=>[c.nom,c.groupe,c.type,t,r,r-t])]}]),`nexora-budget-${DS.y}.xlsx`);toast('✔ Fichier Excel téléchargé')};

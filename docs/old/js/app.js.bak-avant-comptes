const actions=(k,i)=>`<div class="ca"><button class="ghost" data-e="${i.id}" data-k="${k}">✏ Modifier</button><button class="ghost" data-act="dup" data-id="${i.id}" data-k="${k}">⧉ Dupliquer</button><button class="ghost danger" data-act="del" data-id="${i.id}" data-k="${k}">🗑 Supprimer</button></div>`;
function removeItems(k,ids){
  const set=new Set(ids);
  if(k==='finances')list(k).forEach(x=>{if(x.auto&&x.lien&&set.has(x.lien))set.add(x.id)});
  const gone=list(k).filter(x=>set.has(x.id));if(!gone.length)return;
  DB[k]=list(k).filter(x=>!set.has(x.id));if(UI[k])UI[k].sel.clear();save();render();
  toast(`🗑 ${gone.length} supprimé(s)`,()=>{DB[k]=[...list(k),...gone];save();render()});
}
function setStatut(ids,st){const s=new Set(ids);list('finances').forEach(i=>{if(s.has(i.id))i.statut=st});if(UI.finances)UI.finances.sel.clear();save();render();toast(`✔ ${ids.length} ligne(s) : ${st}`)}
function syncDime(o,isNew,want){
  if(!dimeAuto())return;
  const fin=list('finances'),linked=fin.find(x=>x.lien===o.id&&x.auto);
  if(o.type==='Revenu'&&o.statut!=='❌ Annulé'&&num(o.montant)>0&&(linked||(isNew&&want))){
    const m=Math.round(num(o.montant)*dimeTaux()/100),lib='Dîme — '+(o.libelle||o.cat);
    if(linked){linked.montant=m;linked.date=o.date;linked.libelle=lib}
    else fin.push({id:uid(),created:new Date().toISOString(),date:o.date,type:'Dépense Fixe',cat:'Dîmes',libelle:lib,montant:m,statut:'⏳ En attente',note:`Calculée automatiquement : ${dimeTaux()} % de ${fmt(o.montant)}`,lien:o.id,auto:1});
  }else if(linked&&o.type!=='Revenu'){DB.finances=fin.filter(x=>x!==linked)}
}

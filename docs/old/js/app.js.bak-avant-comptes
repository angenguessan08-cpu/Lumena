  else if(d.new!==undefined){ev.preventDefault();const pre={};(d.pre||'').split('&').filter(Boolean).forEach(p=>{const[a,b]=p.split('=');pre[a]=b});openForm(d.new,null,pre)}
  else if(d.e!==undefined)openForm(d.k,d.e);
});

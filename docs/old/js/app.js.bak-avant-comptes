/* ---------- Pages de module (tableaux + filtres) ---------- */
const UI={};
function matchQ(i,q){return !q||Object.entries(i).some(([k,v])=>k!=='fichier'&&k!=='photo'&&String(v).toLowerCase().includes(q))}
function monthOf(i){return (i.date||i.created||'').slice(0,7)}
const fval=(i,f)=>f.k==='_mois'?monthOf(i):f.k==='_annee'?(i.date||'').slice(0,4):f.k==='_groupe'?(catOf(i.cat)?.groupe||''):String(i[f.k]||'');
function filtered(k){const m=MODULES[k],u=UI[k],q=u.q.toLowerCase();
  return list(k).filter(i=>matchQ(i,q)&&m.filters.every(f=>{const v=u.f[f.k];return !v||fval(i,f)===v}))}
function filterOpts(k,f){let a=list(k);const y=UI[k]?.f._annee;if(f.k==='_mois'&&y)a=a.filter(i=>(i.date||'').startsWith(y));return [...new Set(a.map(i=>fval(i,f)).filter(Boolean))].sort().reverse()}
function modulePage(k,el){
  const m=MODULES[k],u=UI[k]=UI[k]||{q:'',f:m.defFilters?m.defFilters():{},view:m.card?'cards':'table',sort:null,limit:100,sel:new Set()};
  el.innerHTML=`<div class="head"><h1>${m.icon} ${m.label}</h1><div class="acts">${m.card?`<button class="ghost ${u.view==='cards'?'on':''}" data-view="cards">▦ Cartes</button><button class="ghost ${u.view==='table'?'on':''}" data-view="table">☰ Tableau</button>`:''}<button class="ghost" id="xl">⬇ Excel</button><button data-new="${k}">＋ Ajouter</button></div></div>
  <div class="card filt"><input id="q" placeholder="🔎 Rechercher dans ${m.label}…" value="${esc(u.q)}">${m.filters.map(f=>`<select data-f="${f.k}"><option value="">${f.l} : tous</option>${filterOpts(k,f).map(o=>`<option ${u.f[f.k]===o?'selected':''}>${esc(o)}</option>`).join('')}</select>`).join('')}<button class="ghost" id="rst">Réinitialiser</button></div>
  <div id="out"></div>`;
  const draw=()=>{
    const a=filtered(k),all=list(k),s=u.sort||{k:m.sort,dir:m.asc?1:-1};
    const sorted=[...a].sort((x,y)=>{const A=x[s.k]??'',B=y[s.k]??'';return (typeof A==='number'&&typeof B==='number'?A-B:String(A).localeCompare(String(B),'fr'))*s.dir});
    let body;
    if(!sorted.length)body=`<div class="card empty">${all.length?'Aucun résultat avec ces filtres.':'Rien ici pour le moment.'} <button data-new="${k}">＋ Ajouter</button></div>`;
    else if(m.card&&u.view==='cards')body=`<div class="cards">${sorted.map(m.card).join('')}</div>`;
    else body=`${u.sel.size?`<div class="card bulk"><b>${u.sel.size} sélectionné(s)</b><button class="ghost danger" data-bulk="del">🗑 Supprimer</button>${k==='finances'?'<button class="ghost" data-bulk="pay">✅ Marquer payé</button><button class="ghost" data-bulk="wait">⏳ En attente</button><button class="ghost" data-bulk="cancel">❌ Annuler</button>':''}<button class="ghost" data-bulk="xl">⬇ Excel (sélection)</button><button class="ghost" data-bulk="none">Tout désélectionner</button></div>`:''}<div class="card tw"><table><thead><tr><th><input type="checkbox" data-selall ${sorted.slice(0,u.limit).every(i=>u.sel.has(i.id))?'checked':''} title="Tout sélectionner"></th>${m.cols.map(c=>`<th ${c.nosort||!c.k?'':`data-sort="${c.k}"`} class="${c.cls||''}">${c.l}${s.k===c.k?(s.dir>0?' ▲':' ▼'):''}</th>`).join('')}<th class="num">Actions</th></tr></thead>
      <tbody>${sorted.slice(0,u.limit).map(i=>`<tr class="r" data-e="${i.id}" data-k="${k}"><td><input type="checkbox" data-sel="${i.id}" ${u.sel.has(i.id)?'checked':''}></td>${m.cols.map(c=>`<td class="${c.cls||''}">${c.f?c.f(i):esc(i[c.k]??'')}</td>`).join('')}<td class="num act">${m.rowAct?m.rowAct(i):''}<button class="ghost" data-e="${i.id}" data-k="${k}" title="Modifier">✏</button><button class="ghost" data-act="dup" data-id="${i.id}" data-k="${k}" title="Dupliquer">⧉</button><button class="ghost danger" data-act="del" data-id="${i.id}" data-k="${k}" title="Supprimer">🗑</button></td></tr>`).join('')}</tbody></table>${sorted.length>u.limit?`<p style="text-align:center"><button class="ghost" data-more>Afficher plus (${sorted.length-u.limit} restants)</button></p>`:''}</div>`;
    $('#out').innerHTML=(m.top?m.top(a,all):'')+body+`<div class="sum"><span>${a.length} / ${all.length} élément(s)</span>${m.summary?m.summary(a):''}</div>`;
  };
  draw();
  $('#q').oninput=e=>{u.q=e.target.value;u.limit=100;draw()};
  el.querySelectorAll('[data-f]').forEach(s=>s.onchange=()=>{u.f[s.dataset.f]=s.value;u.limit=100;if(s.dataset.f==='_annee')render();else draw()});
  $('#rst').onclick=()=>{u.q='';u.f={};u.limit=100;render()};
  $('#xl').onclick=()=>exportModule(k);
  el.onchange=ev=>{const t=ev.target;
    if(t.dataset.sel!==undefined){t.checked?u.sel.add(t.dataset.sel):u.sel.delete(t.dataset.sel);draw()}
    if(t.dataset.selall!==undefined){filtered(k).slice(0,u.limit).forEach(i=>t.checked?u.sel.add(i.id):u.sel.delete(i.id));draw()}};
  el.onclick=ev=>{const b=ev.target.closest('[data-bulk]');
    if(b){const ids=[...u.sel],w=b.dataset.bulk;
      if(w==='del'){if(confirm(`Supprimer ${ids.length} élément(s) ?`))removeItems(k,ids)}
      else if(w==='pay')setStatut(ids,'✅ Payé');else if(w==='wait')setStatut(ids,'⏳ En attente');else if(w==='cancel')setStatut(ids,'❌ Annulé');
      else if(w==='none'){u.sel.clear();draw()}
      else if(w==='xl'){download(xlsx([sheetOf(k,list(k).filter(i=>u.sel.has(i.id)))]),`nexora-${k}-selection.xlsx`);toast('✔ Fichier Excel téléchargé')}
      return}
    const t=ev.target.closest('[data-sort],[data-view],[data-more]');if(!t)return;
    if(t.dataset.more!==undefined){u.limit+=200;draw();return}
    if(t.dataset.sort){const cur=u.sort||{k:m.sort,dir:m.asc?1:-1};u.sort={k:t.dataset.sort,dir:cur.k===t.dataset.sort?-cur.dir:1};draw()}
    if(t.dataset.view){u.view=t.dataset.view;render()}};
}


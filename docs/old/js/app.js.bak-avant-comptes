/* ---------- Accès administrateur (zone développeur) ----------
   Verrou côté navigateur : il écarte les utilisateurs ordinaires, mais ne remplace pas une vraie
   gestion de rôles côté serveur (à prévoir avec Supabase/auth avant toute diffusion). */
const isAdmin=()=>{try{return sessionStorage.getItem('nx.admin')==='1'}catch{return false}};
const setAdmin=v=>{try{v?sessionStorage.setItem('nx.admin','1'):sessionStorage.removeItem('nx.admin')}catch{}};
async function sha(s){try{const b=await crypto.subtle.digest('SHA-256',new TextEncoder().encode('nexora:'+s));return [...new Uint8Array(b)].map(x=>x.toString(16).padStart(2,'0')).join('')}catch{return 'p:'+btoa(unescape(encodeURIComponent(s)))}}
function passModal(title,fields){
  return new Promise(res=>{const ov=document.createElement('div');ov.className='ov';
    ov.innerHTML=`<form class="card modal" style="max-width:420px"><h2>${title}</h2>${fields.map((f,i)=>`<div style="margin-bottom:10px"><label>${f}</label><input type="password" name="p${i}" ${i?'':'autofocus'} autocomplete="off"></div>`).join('')}<div class="mact"><button type="button" class="ghost" data-x>Annuler</button><button>Valider</button></div></form>`;
    document.body.appendChild(ov);const done=v=>{ov.remove();res(v)};
    ov.onclick=e=>{if(e.target===ov||e.target.dataset.x!==undefined)done(null)};
    ov.querySelector('form').onsubmit=e=>{e.preventDefault();const f=new FormData(e.target);done(fields.map((_,i)=>f.get('p'+i)))}});
}
async function adminLogin(){
  if(!DB.adminHash){
    const r=await passModal('Créer le mot de passe administrateur',['Nouveau mot de passe (6 caractères min.)','Confirmer']);
    if(!r)return;if(r[0].length<6||r[0]!==r[1]){toast('⚠ Mots de passe invalides ou différents');return}
    DB.adminHash=await sha(r[0]);save();setAdmin(true);toast('✔ Compte administrateur créé');go('admin');return}
  const r=await passModal('🔒 Accès administrateur',['Mot de passe']);if(!r)return;
  if(await sha(r[0])===DB.adminHash){setAdmin(true);toast('✔ Accès accordé');go('admin')}else toast('⛔ Mot de passe incorrect');
}

